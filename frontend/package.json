{
  "name": "recall-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "mkdir -p .playwright-downloads && TMPDIR=\"$PWD/.playwright-downloads\" PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers playwright test",
    "test:e2e:install": "mkdir -p .playwright-downloads && TMPDIR=\"$PWD/.playwright-downloads\" PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers playwright install chromium",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "jsdom": "^26.1.0",
    "typescript": "~5.9.2",
    "vite": "^7.1.3",
    "vitest": "^4.1.11"
  }
}
